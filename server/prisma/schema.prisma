// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Invoice {
  id                Int      @id @default(autoincrement())
  invoiceDate       DateTime
  paymentType       String   // e.g., "Banküberweisung", "Booking.com"
  invoiceNumber     String   @unique // e.g., "Rechnung 17841 / 2025"
  recipient         String
  amount            Decimal  @db.Decimal(12, 2)
  tax7Amount        Decimal? @db.Decimal(12, 2)
  tax19Amount       Decimal? @db.Decimal(12, 2)
  cityTaxAmount     Decimal? @db.Decimal(12, 2)
  netAmount         Decimal? @db.Decimal(12, 2)
  amountPaid        Decimal  @default(0.00) @db.Decimal(12, 2)
  status            String   @default("OPEN") // "OPEN", "PARTIAL", "PAID"

  // Reconciliation Status
  isReconciled      Boolean  @default(false)
  reconciledDate    DateTime?
  manualStatus      Boolean  @default(false) // Manually checked off
  comment           String?

  // Dunning / Reminder
  dunningStatus     String?  // "Reminder", "Warning 1", "Warning 2"
  dunningMethod     String?  // "Email", "Post"
  dunningDate       DateTime?

  // Relations
  matches           ReconciliationMatch[]
  pmsPayments       PmsPayment[]
  roomReservations  RoomReservation[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([invoiceDate])
  @@index([isReconciled, invoiceDate])
}

model BankTransaction {
  id                Int      @id @default(autoincrement())
  bookingDate       DateTime
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("EUR")
  senderReceiver    String?
  description       String?  // Verwendungszweck

  // SHA-256 of "bookingDate|amount|description" — prevents duplicate imports
  externalHash      String?  @unique

  // Relations
  matches           ReconciliationMatch[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bookingDate])
}

model BookingPayment {
  id                Int      @id @default(autoincrement())
  referenceNumber   String   @unique
  // Nullable: not every Booking.com export includes all date columns
  checkInDate       DateTime?
  checkOutDate      DateTime?
  payoutDate        DateTime?
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("EUR")

  // Relations
  matches           ReconciliationMatch[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([checkInDate])
}

model CardPayment {
  id                Int      @id @default(autoincrement())
  transactionDate   DateTime
  cardType          String   // e.g., "Visa", "Mastercard"
  amount            Decimal  @db.Decimal(12, 2)
  grossAmount       Decimal? @db.Decimal(12, 2)

  // SHA-256 of "transactionDate|cardType|amount" — prevents duplicate imports
  externalHash      String?  @unique

  // Relations
  matches           ReconciliationMatch[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([transactionDate])
}

model ReconciliationMatch {
  id                Int      @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Polymorphic-like relation (exactly one of these should be set)
  bankTransactionId Int?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  bookingPaymentId  Int?
  bookingPayment    BookingPayment? @relation(fields: [bookingPaymentId], references: [id])

  cardPaymentId     Int?
  cardPayment       CardPayment? @relation(fields: [cardPaymentId], references: [id])

  matchType         String   // "AUTOMATIC", "MANUAL_REF", "MANUAL"
  confidence        Float?   // 1.0 for exact match

  pmsPaymentId      Int?
  pmsPayment        PmsPayment? @relation(fields: [pmsPaymentId], references: [id])

  createdAt         DateTime @default(now())

  @@unique([bankTransactionId])
  @@unique([bookingPaymentId])
  @@unique([cardPaymentId])
  @@index([invoiceId])
  @@index([bankTransactionId])
  @@index([bookingPaymentId])
  @@index([cardPaymentId])
  @@index([pmsPaymentId])
}

model ImportedFile {
  id                Int      @id @default(autoincrement())
  filename          String
  originalName      String
  type              String   // "IBELSA", "BOOKING", "BANK", "NEXI"
  importDate        DateTime @default(now())
  recordCount       Int
  dateRangeStart    DateTime?
  dateRangeEnd      DateTime?
  logs              String?  // JSON string of debug logs
}

model PmsPayment {
  id                Int      @id @default(autoincrement())
  paymentDate       DateTime
  paymentType       String
  invoiceNumber     String?
  recipient         String?
  amount            Decimal  @db.Decimal(12, 2)
  
  invoiceId         Int?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  matches           ReconciliationMatch[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentDate])
}

model RoomReservation {
  id                Int      @id @default(autoincrement())
  category          String
  roomName          String
  checkIn           DateTime
  checkOut          DateTime
  nights            Int
  guestName         String
  pax               Int
  price             Decimal  @db.Decimal(12, 2) // Logis ohne Frühstück
  cityTax           Decimal? @db.Decimal(12, 2)
  isAirbnb          Boolean  @default(false)
  
  invoiceId         Int?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([checkIn])
}
